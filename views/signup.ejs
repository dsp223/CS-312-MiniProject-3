<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up | My Blog</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <div class="container">
            <h1>My Blog</h1>
            <p>Create your account.</p>
        </div>
    </header>

    <main class="container">
        <section class="card">
            <h2>Sign Up</h2>

            <% if (error) { %>
                <p role="alert"><%= error %></p>
            <% } %>

            <form action="/signup" method="POST">
                <label for="user_id">User ID</label>
                <input type="text" id="user_id" name="user_id"
                       maxlength="255" autocomplete="username" required>

                <label for="name">Your Name</label>
                <input type="text" id="name" name="name"
                       maxlength="255" autocomplete="name" required>

                <label for="password">Password</label>
                <input type="password" id="password" name="password"
                       maxlength="255" autocomplete="new-password" required>

                <button type="submit">Create Account</button>
            </form>

            <p>Already have an account? <a href="/signin">Sign in</a></p>
            <p><a href="/">Back to Blog</a></p>
        </section>
    </main>

    <footer>
        <p>CS-312 Mini Project 3</p>
    </footer>
</body>
</html>